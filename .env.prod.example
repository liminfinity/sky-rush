# Hostname only: no https://, path or port. Point its A/AAAA records at this VPS.
SKYRUSH_DOMAIN=play.example.com
POSTGRES_DB=skyrush
POSTGRES_USER=skyrush
# Replace using: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Must match the owner of runtime/config (normally the deployment user).
LOCAL_UID=1000
LOCAL_GID=1000
SKYRUSH_DEMO_ENABLED=true
SKYRUSH_DEMO_INITIAL_BALANCE=1000.00
# Secure cookie and server forwarding are enforced by the production override.
# Sessions are server-side; no SESSION_SECRET or additional Spring profile is needed.
