# Development only; replace the password in your untracked .env.
POSTGRES_DB=skyrush
POSTGRES_USER=skyrush
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Optional repeatable development randomness; leave blank for SecureRandom.
SKYRUSH_RANDOM_SEED=
SKYRUSH_DEMO_ENABLED=true
SKYRUSH_DEMO_INITIAL_BALANCE=1000.00

# Optional Docker backend host identity for writable demo admin config.
# Prefer exporting LOCAL_UID="$(id -u)" and LOCAL_GID="$(id -g)" before Compose.
# LOCAL_UID=1000
# LOCAL_GID=1000

# Set true when serving the game over HTTPS; leave false for local HTTP.
SESSION_COOKIE_SECURE=false
